# Server Port (optional, defaults to 3000)
PORT=3000

# Secret key for JWT signing & verification (optional, defaults to built-in secure key)
JWT_SECRET=grievance_management_system_jwt_secret_key_2026_super_secure

# Google Gemini API Key for Multimodal AI Triage & RAG Assistant (optional, fallback heuristics enabled by default)
GEMINI_API_KEY=your_gemini_api_key_here
